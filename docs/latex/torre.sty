% Autor: Brandon Uriel García Sánchez
% Estilo común de las tres guías de Torre del Caribe (UNRC: guinda #9F2241, dorado #BC955C, Noto Sans).
% Se compila con XeLaTeX:  latexmk -xelatex <archivo>.tex   (desde docs/latex/)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{torre}[2026/10/02 Estilo de las guías de Torre del Caribe]

% ---------- Página e idioma ----------
\RequirePackage[letterpaper,top=24mm,bottom=24mm,left=24mm,right=22mm,headheight=14pt]{geometry}
\RequirePackage{fontspec}
\RequirePackage[spanish,es-noshorthands,es-tabla]{babel}
\spanishplainpercent  % el % sin espacio automático de babel (en fórmulas chocaba con \,)
\setmainfont{NotoSans}[
  Path=../../herramientas/fuentes/, Extension=.ttf,
  UprightFont=*-Regular, BoldFont=*-Bold,
  ItalicFeatures={FakeSlant=0.18}, BoldItalicFeatures={FakeSlant=0.18}, ItalicFont=*-Regular, BoldItalicFont=*-Bold]
\setsansfont{NotoSans}[
  Path=../../herramientas/fuentes/, Extension=.ttf,
  UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Regular, ItalicFeatures={FakeSlant=0.18}]
\RequirePackage{microtype}
\linespread{1.12}
\setlength{\parskip}{0.55em}
\setlength{\parindent}{0pt}
\setlength{\emergencystretch}{3em}  % deja respirar los renglones con rutas largas

% ---------- Matemáticas ----------
\RequirePackage{amsmath,amssymb,mathtools,bm}
\DeclareMathOperator{\Var}{Var}
\DeclareMathOperator{\corr}{corr}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}
\newcommand{\ind}{\mathbb{1}}

% ---------- Colores UNRC ----------
\RequirePackage[table]{xcolor}
\definecolor{guinda}{HTML}{9F2241}
\definecolor{dorado}{HTML}{BC955C}
\definecolor{grisTexto}{HTML}{3A3A3A}
\definecolor{crema}{HTML}{FAF6EF}
\definecolor{verdeok}{HTML}{0B6E4F}
\definecolor{azulnota}{HTML}{1B2A6B}
\color{grisTexto}

% ---------- Títulos ----------
\RequirePackage{titlesec}
\titleformat{\chapter}[display]{\color{guinda}\bfseries\Huge}{\large\color{dorado}\MakeUppercase{Capítulo} \thechapter}{4pt}{}[{\color{dorado}\titlerule[2pt]}]
\titlespacing*{\chapter}{0pt}{-10pt}{18pt}
\titleformat{\part}[display]{\centering\color{guinda}\bfseries\fontsize{30}{36}\selectfont}{\Large\color{dorado}\MakeUppercase{Parte} \thepart}{10pt}{}[{\color{dorado}\titlerule[2pt]}]
\titleformat{\section}{\color{guinda}\bfseries\Large}{\thesection}{0.6em}{}
\titleformat{\subsection}{\color{guinda}\bfseries\large}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\color{grisTexto}\bfseries\normalsize}{\thesubsubsection}{0.6em}{}
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{1}

% ---------- Encabezado y pie ----------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{guinda}Torre del Caribe · UNRC}
\fancyhead[R]{\small\color{dorado}\nouppercase{\leftmark}}
\fancyfoot[C]{\small\color{guinda}\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{{\color{dorado}\hrule width\headwidth height\headrulewidth}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\color{guinda}\thepage}\renewcommand{\headrulewidth}{0pt}}

% ---------- Tablas, listas, figuras, código ----------
\RequirePackage{booktabs,tabularx,longtable,array,multirow}
\renewcommand{\arraystretch}{1.25}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{R}{>{\raggedleft\arraybackslash}X}
\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{#1}}  % columna angosta sin huecos de justificado
\newcommand{\encabezado}{\rowcolor{guinda}}
\newcommand{\h}[1]{\textcolor{white}{\textbf{#1}}}
\newcommand{\filagris}{\rowcolor{crema}}
\RequirePackage{enumitem}
\setlist{itemsep=2pt,topsep=3pt}
\RequirePackage{graphicx}
\graphicspath{{../ejecutivo/figuras/}{../ejecutivo/capturas/}}
\RequirePackage[font=small,labelfont={bf,color=guinda}]{caption}
\RequirePackage{listings}
\lstset{basicstyle=\ttfamily\footnotesize, backgroundcolor=\color{crema}, frame=leftline, rulecolor=\color{dorado},
  framerule=2pt, xleftmargin=6pt, breaklines=true, columns=fullflexible, keepspaces=true, showstringspaces=false,
  keywordstyle=\color{guinda}\bfseries, commentstyle=\color{dorado}, stringstyle=\color{azulnota},
  literate={á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1 {ñ}{{\~n}}1 {Á}{{\'A}}1 {É}{{\'E}}1 {Ó}{{\'O}}1 {ü}{{\"u}}1 {→}{{$\to$}}1 {×}{{$\times$}}1 {≥}{{$\geq$}}1 {≤}{{$\leq$}}1}
\RequirePackage{xurl}
\renewcommand{\UrlFont}{\ttfamily\small}
\newcommand{\codigo}[1]{\path{#1}}  % rutas y nombres de archivo; se pueden partir en / y _

% ---------- Cajas ----------
\RequirePackage[most]{tcolorbox}
\tcbset{enhanced, breakable, boxrule=0.6pt, arc=2pt, left=8pt, right=8pt, top=6pt, bottom=6pt,
  fonttitle=\bfseries\small, before upper={\setlength{\parskip}{0.45em}}}
\newtcolorbox{amano}[1][]{colback=crema, colframe=dorado, coltitle=grisTexto, title={A mano, con números reales#1}}
\newtcolorbox{teprofe}{colback=white, colframe=guinda, coltitle=white, colbacktitle=guinda, title={Si te preguntan}}
\newtcolorbox{supuestos}{colback=white, colframe=azulnota, coltitle=white, colbacktitle=azulnota, title={Supuestos y límites}}
\newtcolorbox{intuicion}{colback=crema, colframe=crema, coltitle=guinda, title={La idea, sin fórmulas}, borderline west={3pt}{0pt}{guinda}}
\newtcolorbox{codigoen}{colback=white, colframe=verdeok, coltitle=white, colbacktitle=verdeok, title={Dónde está en el código}}
\newtcolorbox{decision}{colback=white, colframe=dorado, coltitle=white, colbacktitle=dorado, title={Tu decisión}}
\newtcolorbox{cita}{colback=crema, colframe=crema, borderline west={3pt}{0pt}{dorado}, fontupper=\itshape}
% Cajas de la guía sencilla y de la de decisiones
\newtcolorbox{ejemplo}[1][]{colback=crema, colframe=dorado, coltitle=grisTexto, title={Un ejemplo con números reales#1}}
\newtcolorbox{porque}{colback=white, colframe=azulnota, coltitle=white, colbacktitle=azulnota, title={Por qué así y no de otra forma}}
\newtcolorbox{error}{colback=white, colframe=guinda!70!black, coltitle=white, colbacktitle=guinda!70!black, title={Lo que salió mal y cómo se corrigió}}
\newtcolorbox{opciones}[1][]{colback=white, colframe=dorado, coltitle=white, colbacktitle=dorado, title={#1}}

