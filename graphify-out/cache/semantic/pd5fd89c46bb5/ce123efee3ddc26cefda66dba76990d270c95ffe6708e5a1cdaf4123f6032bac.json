{"nodes": [{"id": "docs_ejecutivo_documento_ejecutivo_documento_ejecutivo", "label": "Documento ejecutivo Torre del Caribe", "file_type": "document", "source_file": "docs/ejecutivo/DOCUMENTO_EJECUTIVO.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null, "rationale": "Explica sin tecnicismos qu\u00e9 hace cada parte del sistema y por qu\u00e9; base para el informe final y el coloquio; cada cifra con fuente oficial."}, {"id": "docs_ejecutivo_documento_ejecutivo_torre_del_caribe", "label": "Torre del Caribe (campa\u00f1a basada en datos)", "file_type": "concept", "source_file": "docs/ejecutivo/DOCUMENTO_EJECUTIVO.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Campa\u00f1a que redistribuye turistas del norte saturado (Canc\u00fan, Playa del Carmen, Tulum) al sur e interior sin llevar la saturaci\u00f3n."}, {"id": "docs_ejecutivo_documento_ejecutivo_radar", "label": "Radar (\u00bfd\u00f3nde hay presi\u00f3n y d\u00f3nde hay espacio?)", "file_type": "concept", "source_file": "docs/ejecutivo/DOCUMENTO_EJECUTIVO.md", "source_location": "L560", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ejecutivo_documento_ejecutivo_pronostico", "label": "Pron\u00f3stico (cu\u00e1ndo ir y cu\u00e1nto invertir)", "file_type": "concept", "source_file": "docs/ejecutivo/DOCUMENTO_EJECUTIVO.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ejecutivo_documento_ejecutivo_torre_en_vivo", "label": "Torre en vivo (vigilancia semanal)", "file_type": "concept", "source_file": "docs/ejecutivo/DOCUMENTO_EJECUTIVO.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ejecutivo_documento_ejecutivo_cinco_regiones", "label": "Cinco regiones promovidas", "file_type": "rationale", "source_file": "docs/ejecutivo/DOCUMENTO_EJECUTIVO.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin sargazo en su costa, sin cierres y sin saturaci\u00f3n; cuatro de cinco en Oth\u00f3n P. Blanco (un solo viaje). Cob\u00e1, Muyil y R\u00edo Hondo retirados (municipio de Tulum, cierre 2024-2026, sin estad\u00edstica)."}, {"id": "docs_ejecutivo_documento_ejecutivo_criterios_de_seleccion", "label": "Cinco criterios de selecci\u00f3n de regiones", "file_type": "rationale", "source_file": "docs/ejecutivo/DOCUMENTO_EJECUTIVO.md", "source_location": "L58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin sargazo 2026, sin cierres, sin saturaci\u00f3n, ecosistema y servicios suficientes, datos oficiales disponibles; en Fase 3 se verifican con datos (Tabla 1)."}, {"id": "docs_ejecutivo_documento_ejecutivo_chetumal", "label": "Chetumal", "file_type": "concept", "source_file": "docs/ejecutivo/DOCUMENTO_EJECUTIVO.md", "source_location": "L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "58 % de ocupaci\u00f3n en 2024 (458,696 de 791,016 noches): 4 de cada 10 cuartos vac\u00edos; vigilar sargazo de la bah\u00eda."}, {"id": "docs_ejecutivo_documento_ejecutivo_bahia_calderitas_oxtankah", "label": "Bah\u00eda de Chetumal: Calderitas y Oxtankah", "file_type": "concept", "source_file": "docs/ejecutivo/DOCUMENTO_EJECUTIVO.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ejecutivo_documento_ejecutivo_ruta_arqueologica_del_sur", "label": "Ruta arqueol\u00f3gica del sur (Kohunlich, Dzibanch\u00e9, Ichkabal)", "file_type": "concept", "source_file": "docs/ejecutivo/DOCUMENTO_EJECUTIVO.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "66,628 visitantes en