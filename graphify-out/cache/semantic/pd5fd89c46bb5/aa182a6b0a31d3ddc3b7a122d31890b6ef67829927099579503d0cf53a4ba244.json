{"nodes": [{"id": "docs_decisiones_02_entorno", "label": "02 \u2014 Entorno de trabajo (Fase 0: cimientos)", "file_type": "document", "source_file": "docs/decisiones/02-entorno.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null}, {"id": "docs_decisiones_02_entorno_decision_fase_0", "label": "Decisi\u00f3n Fase 0: .venv (Python 3.11.9) + PySpark 3.5.6 + JDK 17 + winutils/hadoop.dll 3.3.6", "file_type": "rationale", "source_file": "docs/decisiones/02-entorno.md", "source_location": "L5-L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Versiones fijas en requirements.txt para reproducibilidad."}, {"id": "docs_decisiones_02_entorno_pyspark_3_5_6", "label": "PySpark 3.5.6 (no 4.x)", "file_type": "concept", "source_file": "docs/decisiones/02-entorno.md", "source_location": "L14-L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Es la l\u00ednea compatible con los binarios de Hadoop 3.3.6 para Windows, que s\u00ed existen y se verificaron."}, {"id": "docs_decisiones_02_entorno_jdk_17", "label": "JDK 17 (OpenJDK 17.0.20.1 de Microsoft)", "file_type": "concept", "source_file": "docs/decisiones/02-entorno.md", "source_location": "L10-L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La m\u00e1quina solo ten\u00eda Java 1.8.0_481 (verificado 26-sep-2026); PySpark moderno exige Java 17. Instalado con winget install Microsoft.OpenJDK.17."}, {"id": "docs_decisiones_02_entorno_winutils_hadoop_dll", "label": "winutils.exe + hadoop.dll 3.3.6 (herramientas/hadoop/bin)", "file_type": "concept", "source_file": "docs/decisiones/02-entorno.md", "source_location": "L14-L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin ellos Spark no puede escribir Parquet en Windows; fuente github.com/cdarlint/winutils, ejecutables PE32+ x86-64."}, {"id": "docs_decisiones_02_entorno_huellas_sha256", "label": "Huellas SHA-256 de winutils.exe y hadoop.dll", "file_type": "rationale", "source_file": "docs/decisiones/02-entorno.md", "source_location": "L18-L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifican la integridad de los binarios descargados: winutils 496a591e\u20268553, hadoop.dll d7ab36a6\u202605be3."}, {"id": "docs_decisiones_02_entorno_venv_aislado", "label": "Entorno aislado .venv", "file_type": "rationale", "source_file": "docs/decisiones/02-entorno.md", "source_location": "L16-L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Graphify (extra [leiden]) baj\u00f3 numpy del Python global a 1.26.4; el .venv evita que eso u otra instalaci\u00f3n afecte al proyecto."}, {"id": "docs_decisiones_02_entorno_java_8_intacto", "label": "Java 8 intacto (JAVA_HOME solo dentro del proceso)", "file_type": "rationale", "source_file": "docs/decisiones/02-entorno.md", "source_location": "L12-L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "entorno.py apunta JAVA_HOME al JDK 17 solo dentro del proceso del proyecto; no se cambia nada m\u00e1s en Windows."}, {"id": "docs_decisiones_02_entorno_descartada_docker", "label": "Opci\u00f3n descartada: Spark dentro de Docker", "file_type": "rationale", "source_file": "docs/decisiones/02-entorno.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Funciona, pero es m\u00e1s pesado de arrancar y de explicar en el coloquio."}, {"id": "docs_decisiones_02_entorno_descartada_cambiar_java_sistema", "label": "Opci\u00f3n descartada: cambiar el Java de todo Windows", "file_type": "rationale", "source_file": "docs/decisiones/02-entorno.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rat