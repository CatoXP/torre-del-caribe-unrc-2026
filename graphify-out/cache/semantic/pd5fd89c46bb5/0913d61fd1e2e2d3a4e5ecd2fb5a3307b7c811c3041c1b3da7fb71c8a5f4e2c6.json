{"nodes": [{"id": "docs_decisiones_11_pronostico", "label": "Decisi\u00f3n 11 \u2014 A3 Pron\u00f3stico (Fase 5, en curso)", "file_type": "document", "source_file": "docs/decisiones/11-pronostico.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null}, {"id": "docs_decisiones_11_pronostico_medidas_mas_norte", "label": "Decisi\u00f3n 1: pronosticar 'Medidas + norte'", "file_type": "rationale", "source_file": "docs/decisiones/11-pronostico.md", "source_location": "Decisi\u00f3n 1", "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null, "rationale": "El sur no tiene ocupaci\u00f3n oficial 2025\u20132026; solo series medidas que llegan a 2026 (INAH Oxtankah, Ruta sur, cruces desde Belice, ocupaci\u00f3n de Canc\u00fan como referencia). Descartadas: solo INAH (Chetumal sin serie) y estimar ocupaci\u00f3n del sur _est (contradice Fase 3, solo 36 meses)."}, {"id": "docs_decisiones_11_pronostico_hueco_forma_del_ano", "label": "Decisi\u00f3n 2: 'Hueco + forma del a\u00f1o' (meses cerrados no entrenan)", "file_type": "rationale", "source_file": "docs/decisiones/11-pronostico.md", "source_location": "Decisi\u00f3n 2", "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null, "rationale": "Un mes cerrado no es cero demanda; se marca y no entrena pero se conserva. La forma del a\u00f1o se aprende de todos los a\u00f1os abiertos y el nivel de los meses posteriores a la reapertura. Descartadas: solo desde reapertura (19 meses < 24) y ceros como dato real (temporada falsa)."}, {"id": "docs_decisiones_11_pronostico_regla_cierre_mes_parcial", "label": "Reglas de cierre y mes parcial", "file_type": "concept", "source_file": "docs/decisiones/11-pronostico.md", "source_location": "Decisi\u00f3n 2, reglas 1\u20132", "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null}, {"id": "docs_decisiones_11_pronostico_pandemia_parametros", "label": "Par\u00e1metros PANDEMIA_INAH y PANDEMIA_BELICE", "file_type": "concept", "source_file": "docs/decisiones/11-pronostico.md", "source_location": "Decisi\u00f3n 2, regla 3", "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null, "rationale": "INAH mar-2020\u2192dic-2021 (Kohunlich 2021 al 52 % de 2019); Belice mar-2020\u2192feb-2022 (frontera casi cerrada, 0\u20137 % de 2019)."}, {"id": "docs_decisiones_11_pronostico_region_suma_zonas", "label": "Regla: regi\u00f3n = suma de sus zonas", "file_type": "rationale", "source_file": "docs/decisiones/11-pronostico.md", "source_location": "Decisi\u00f3n 2, regla 4", "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null, "rationale": "Si una zona existente est\u00e1 cerrada o parcial, se marca el mes de toda la regi\u00f3n (ene-2025: Dzibanch\u00e9 cerrada); Ichkabal antes de 2025 no exist\u00eda, su ausencia no es cierre."}, {"id": "docs_decisiones_11_pronostico_pronostico_series_parquet", "label": "datos/gold/pronostico_series.parquet", "file_type": "concept", "source_file": "docs/decisiones/11-pronostico.md", "source_location": "Resultado pieza 1", "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null}, {"id": "docs_decisiones_11_pronostico_cruces_belice", "label": "Serie de cruces desde Belice (Chetumal)", "file_type": "concept", "source_file": "docs/decisiones/11-pronostico.md", "source_location": "Decisi\u00f3n 1", "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null}, {"id": "docs_decisiones_11_pronostico_ocupacion_cancun_referencia", "label": "Ocupaci\u00f3n hotelera de Canc\u00fan (serie de referencia)", "file_type": "concept", "source_file": "docs/decisiones/11-pronostico.md", "source_location": "Decisi\u00f3n 1", "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null, "rationale": "Es el p\u00fablico de la campa\u00f1a: saber cu\u00e1ndo se llena el norte indica cu\u00e1ndo redirigir gente al sur."}, {"id": "docs_decisiones_11_pronostico_hueco_tren_maya", "label": "Hueco: Tren Maya con menos de 24 meses (variable, no se pronostica)", "file_type": "rationale", "source_file": "docs/decisiones/11-pronostico.md", "source_location": "Huecos declarados", "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null}, {"id": "docs_decisiones_11_pronostico_descomposicion_estacional", "label": "Pieza 2: descomposici\u00f3n estacional (forma y fuerza de la temporada)", "file_type": "concept", "source_file": "docs/decisiones/11-pronostico.md", "source_location": "Siguientes piezas", "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null}, {"id": "docs_decisiones_11_pronostico_regresion_con_clima", "label": "Regresi\u00f3n con clima", "file_type": "concept", "source_file": "docs/decisiones/11-pronostico.md", "source_location": "Siguientes piezas", "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null}, {"id": "docs_decisiones_11_pronostico_gradient_boosting_rezagos", "label": "Gradient Boosting con rezagos", "file_type": "concept", "source_file": "docs/decisiones/11-pronostico.md", "source_location": "Siguientes piezas", "source_url": null, "captured_at": null, "author": "Brandon Uriel Garc\u00eda S\u00e1nchez", "contributor": null}], "edges": [{"source": "docs_decisiones_11_pronostico", "target": "docs_decisiones_10_silver_fase5", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisiones/11-pronostico.md", "source_location": "Huecos declarados", "weight": 1.0}, {"source": "docs